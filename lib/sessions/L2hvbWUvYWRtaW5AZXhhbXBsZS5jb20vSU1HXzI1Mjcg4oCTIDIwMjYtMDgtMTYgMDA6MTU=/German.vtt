<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KIT Lecture Translator</title>
    <link rel="stylesheet" href="/static/css/theme.css">
    <link rel="stylesheet" href="/static/css/status-page.css">
  </head>
  <body>

<header class="kit-header">
  <div class="kit-header__container">
    <div class="kit-header__content">
      
      <link rel="stylesheet" href="/static/themes/kittheme/css/kit.css">

<a href="/index/" class="kit-header__logo">
  
  <img src="/static/themes/kittheme/img/logo.png" alt="KIT Logo" class="kit-header__logo-image">
  <h1 class="kit-header__title">KIT Lecture Translator</h1>
</a>


    </div>
  </div>
</header>

<div class="status-container">
  <div class="status-card">
    <div class="status-icon error">
      <svg viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>
    <h1 class="status-title">Error</h1>
    <p class="status-message">Could not connect: INTERNAL SERVER ERROR</p>
    <div class="status-actions">
      <a href="/index/" class="status-button">Go to Home</a>
      <a href="javascript:history.back()" class="status-button secondary">Go Back</a>
    </div>
  </div>
</div>

  </body>
</html>